APP_HOST=127.0.0.1
APP_PORT=8081
APP_BASE_URL=http://127.0.0.1:8081
APP_DATABASE_PATH=./data/opencode-web.db
APP_COOKIE_SECURE=false

MAX_ACTIVE_SESSIONS=1
MAX_ACTIVE_SESSIONS_HARD_LIMIT=10
# Персональный лимит активных заданий (0 = выключен; применяется к пользователям без своего значения)
MAX_ACTIVE_SESSIONS_PER_USER=0
# Верхняя граница для персональных лимитов, задаваемых администратором
MAX_ACTIVE_SESSIONS_PER_USER_HARD_LIMIT=10
MAX_QUEUED_MESSAGES=1000

# Локальный запуск: все создаваемые рабочие папки остаются внутри проекта.
# Docker Compose переопределяет путь на совместимый контейнерный /home/appuser/workspaces.
ALLOWED_WORKSPACE_ROOTS=./data/workspaces
ALLOW_SHARED_WORKSPACES=false

OPENCODE_BIN=/usr/bin/opencode
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT_RANGE_START=4100
OPENCODE_PORT_RANGE_END=4199
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_DEFAULT_AGENT=build
OPENCODE_ALLOWED_AGENTS=build,plan
OPENCODE_DEFAULT_MODEL=
OPENCODE_ALLOWED_MODELS=*
OPENCODE_START_TIMEOUT_SECONDS=120

SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=24
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=./.secrets/admin-password
LOG_LEVEL=INFO

# Docker Compose: container ownership and reproducible tool versions.
DOCKER_UID=1000
DOCKER_GID=1000
OPENCODE_VERSION=1.18.25
CONAN_VERSION=2.27.0
GIT_USER_NAME=OpenCode Web
GIT_USER_EMAIL=opencode-web@localhost
GIT_GPG_SIGNING_ENABLED=false
GIT_GPG_KEY_ID=
GIT_GPG_PRIVATE_KEY_FILE=/app/.secrets/gpg/private.asc
GIT_GPG_PASSPHRASE_FILE=/app/.secrets/gpg/passphrase

# Credentials are required at runtime and must never be committed.
YOUTRACK_AUTHORIZATION='Bearer replace-with-youtrack-token'
GITLAB_READ_TOKEN=replace-with-gitlab-token

# Для корпоративного CA скопируйте доверенный bundle в .secrets/ca и задайте
# TLS_CA_BUNDLE=/app/.secrets/ca/ca-certificates.crt
TLS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Optional direct-message notifications. Reuse the protected token file used by
# the Mattermost MCP; never put the token itself in this file.
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN_FILE=./.secrets/mattermost-token
MATTERMOST_CA_BUNDLE=./.secrets/ca/ca-certificates.crt
MATTERMOST_TIMEOUT_SECONDS=30
MATTERMOST_NOTIFICATION_MAX_ATTEMPTS=8

# Stop fully idle workspace processes after 15 minutes; 0 disables auto-stop.
OPENCODE_IDLE_TIMEOUT_SECONDS=900

# Дополнительный режим «С изоляцией»; выбирается администратором в интерфейсе.
# Старый режим «Без изоляции» используется по умолчанию.
# Podman запускается от непривилегированной сервисной учётной записи.
PODMAN_BIN=/usr/bin/podman
PODMAN_IMAGE=localhost/valeria-opencode:1.18.25
PODMAN_STATE_ROOT=./data/podman
# Каталог с opencode.jsonc; отдельный конфиг без секретов веб-приложения.
PODMAN_CONFIG_DIR=
PODMAN_MEMORY_MB=4096
PODMAN_CPUS=2
PODMAN_PIDS_LIMIT=512
# Только явно разрешённые переменные провайдеров, например OPENAI_API_KEY.
PODMAN_FORWARD_ENV=
