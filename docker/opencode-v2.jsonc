{
  "$schema": "https://opencode.ai/config.json",
  // Add the providers, models and MCP servers required by this environment.
  "providers": {},
  "mcp": {
    "servers": {
      "consultation-artifacts": {
        "type": "local",
        "command": [
          "/home/appuser/mcp/mcp-consultation-artifacts/venv/bin/python",
          "/home/appuser/mcp/mcp-consultation-artifacts/server.py"
        ],
        "cwd": "/home/appuser/mcp/mcp-consultation-artifacts",
        "environment": {
          "VALERIA_URL": "http://127.0.0.1:8081",
          "VALERIA_ARTIFACT_TOKEN_FILE": "/app/data/consultation-artifacts.token",
          "VALERIA_REQUEST_TIMEOUT_SECONDS": "60"
        },
        "enabled": true,
        "codemode": false,
        "timeout": 60000
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    {
      "action": "external_directory",
      "resource": "/app/data/consultation-staging/**",
      "effect": "allow"
    },
    { "action": "edit", "resource": "/app/data/consultation-staging/**", "effect": "allow" },
    { "action": "read", "resource": "/app/data/consultation-staging/**", "effect": "allow" }
  ]
}
