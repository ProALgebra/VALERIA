FROM node:22-bookworm-slim AS opencode-build

ARG OPENCODE_VERSION=1.18.25
RUN npm install --global --omit=dev "opencode-ai@${OPENCODE_VERSION}"

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG CONAN_VERSION=2.27.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        ninja-build \
        openssh-client \
        pkg-config \
        python3.12 \
        python3.12-venv \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

COPY --from=opencode-build /usr/local/bin/node /usr/local/bin/node
COPY --from=opencode-build /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=opencode-build /usr/local/lib/node_modules/opencode-ai /usr/local/lib/node_modules/opencode-ai
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /usr/local/lib/node_modules/opencode-ai/bin/opencode.exe /usr/bin/opencode \
    && /usr/bin/opencode --version \
    && if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash agent \
    && python3.12 -m venv /opt/valeria/venv \
    && /opt/valeria/venv/bin/pip install --no-cache-dir "conan==${CONAN_VERSION}" \
    && git config --system user.name "Valeria Agent" \
    && git config --system user.email "valeria-agent@localhost" \
    && git config --system commit.gpgSign false \
    && git config --system tag.gpgSign false

# Copy only worker code and dependency manifests, never local config.env or state.
COPY mcp/mcp-memory-server/*.py mcp/mcp-memory-server/requirements.txt /opt/valeria/mcp/mcp-memory-server/
COPY mcp/mcp-gitlab-readonly/*.py mcp/mcp-gitlab-readonly/requirements.txt /opt/valeria/mcp/mcp-gitlab-readonly/
COPY mcp/mcp-vision-server/server.py mcp/mcp-vision-server/client.py mcp/mcp-vision-server/config.py mcp/mcp-vision-server/images.py mcp/mcp-vision-server/requirements.lock.txt /opt/valeria/mcp/mcp-vision-server/
RUN python3.12 -m venv /opt/valeria/mcp/mcp-memory-server/venv \
    && /opt/valeria/mcp/mcp-memory-server/venv/bin/pip install --no-cache-dir \
        -r /opt/valeria/mcp/mcp-memory-server/requirements.txt \
    && python3.12 -m venv /opt/valeria/mcp/mcp-gitlab-readonly/venv \
    && /opt/valeria/mcp/mcp-gitlab-readonly/venv/bin/pip install --no-cache-dir \
        -r /opt/valeria/mcp/mcp-gitlab-readonly/requirements.txt \
    && python3.12 -m venv /opt/valeria/mcp/mcp-vision-server/venv \
    && /opt/valeria/mcp/mcp-vision-server/venv/bin/pip install --no-cache-dir \
        -r /opt/valeria/mcp/mcp-vision-server/requirements.lock.txt \
    && mkdir -p /etc/valeria/opencode

ENV HOME=/home/agent \
    PATH=/opt/valeria/venv/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin \
    OPENCODE_BIN=/usr/bin/opencode \
    XDG_CONFIG_HOME=/home/agent/.config \
    XDG_DATA_HOME=/home/agent/.local/share \
    XDG_STATE_HOME=/home/agent/.local/state \
    XDG_CACHE_HOME=/home/agent/.cache \
    OPENCODE_DISABLE_AUTOUPDATE=true \
    OPENCODE_DISABLE_DEFAULT_PLUGINS=true \
    OPENCODE_DISABLE_LSP_DOWNLOAD=true \
    OPENCODE_PURE=true \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# --userns=keep-id selects the non-root service UID at runtime. Its persistent
# HOME and the current workspace are the only host directories mounted writable.
USER agent
WORKDIR /home/agent
EXPOSE 4100
CMD ["/usr/bin/opencode", "serve", "--hostname", "0.0.0.0", "--port", "4100"]
