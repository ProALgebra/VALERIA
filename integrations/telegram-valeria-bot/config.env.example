# Create a bot with @BotFather, then fill ONE token option below.
# A non-empty TELEGRAM_BOT_TOKEN_FILE takes precedence over TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_FILE=/etc/valeria-telegram-bot.token

# Existing Valeria installation. HTTPS is recommended outside loopback.
VALERIA_BASE_URL=http://127.0.0.1:8081

# Local development path; use /var/lib/valeria-telegram/state.db with the supplied service.
# Contains backend session credentials and private user state; keep it private.
TELEGRAM_STATE_DB=data/telegram-bot.db

# Optional comma-separated Telegram numeric USER IDs. Empty means any Telegram
# user can attempt to log in with their own existing Valeria account.
TELEGRAM_ALLOWED_USER_IDS=

REQUEST_TIMEOUT_SECONDS=30
TELEGRAM_LONG_POLL_SECONDS=25
TELEGRAM_POLL_INTERVAL_SECONDS=3

# Optional readable PEM CA bundle for the Valeria HTTPS endpoint.
# TLS verification remains enabled. Leave empty for system trust roots.
TLS_CA_BUNDLE=
