# Адрес Valeria; при необходимости включает префикс reverse proxy.
VALERIA_URL=http://127.0.0.1:8081

# Все инструменты работают от имени этой учётной записи.
VALERIA_LOGIN=mcp-user

# Рекомендуется файл с паролем (имеет приоритет над VALERIA_PASSWORD).
# Укажите абсолютный путь. Файл должен быть доступен процессу MCP.
VALERIA_PASSWORD_FILE=/absolute/path/to/valeria-password
# VALERIA_PASSWORD=replace-with-user-password

VALERIA_REQUEST_TIMEOUT_SECONDS=30

# Необязательно: CA bundle для HTTPS с собственным центром сертификации.
# VALERIA_CA_BUNDLE=/absolute/path/to/ca.pem
