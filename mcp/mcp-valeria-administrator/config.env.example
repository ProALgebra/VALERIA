# Адрес Valeria; допускается префикс reverse proxy.
VALERIA_ADMIN_URL=http://127.0.0.1:8081

# Все инструменты работают от имени этой учётной записи с ролью admin.
VALERIA_ADMIN_LOGIN=admin

# Файл пароля имеет приоритет над VALERIA_ADMIN_PASSWORD.
VALERIA_ADMIN_PASSWORD_FILE=/absolute/path/to/valeria-admin-password
# VALERIA_ADMIN_PASSWORD=replace-with-admin-password

VALERIA_ADMIN_REQUEST_TIMEOUT_SECONDS=30

# Для HTTPS с собственным центром сертификации.
# VALERIA_ADMIN_CA_BUNDLE=/absolute/path/to/ca.pem
